rikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"2026-07-06 · 黑粉科技 原创","href":null}],"icon":null,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-8197-bc6c-d833804bdf4e","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"image","image":{"caption":[{"type":"text","text":{"content":"MacBook Pro 刘海屏玩游戏：画面中间永远少一块","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"MacBook Pro 刘海屏玩游戏：画面中间永远少一块","href":null}],"type":"external","external":{"url":"https://hyphentech.top/images/game-res/cover.jpg"}},"archived":false},{"object":"block","id":"39599968-1bdb-8133-a808-dd6baa8b757a","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"heading_2","heading_2":{"rich_text":[{"type":"text","text":{"content":"先说痛点：刘海是怎么毁掉一局游戏的","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"先说痛点：刘海是怎么毁掉一局游戏的","href":null}],"is_toggleable":false,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-8139-8ba3-dbdec2045394","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"paragraph","paragraph":{"rich_text":[{"type":"text","text":{"content":"事情是这样的。换了台 MacBook Pro 16 寸，M 系列芯片性能猛，屏幕 120Hz ProMotion 丝滑，兴冲冲装了个游戏准备爽一把。全屏一进去——好家伙，画面正中间顶部，硬生生少了一块。","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"事情是这样的。换了台 MacBook Pro 16 寸，M 系列芯片性能猛，屏幕 120Hz ProMotion 丝滑，兴冲冲装了个游戏准备爽一把。全屏一进去——好家伙，画面正中间顶部，硬生生少了一块。","href":null}],"icon":null,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-81c5-86be-db54acb4d196","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"paragraph","paragraph":{"rich_text":[{"type":"text","text":{"content":"那块少掉的区域就是刘海。平时看网页、写文档它还算安分，但游戏全屏的时候它就开始捣乱了：","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"那块少掉的区域就是刘海。平时看网页、写文档它还算安分，但游戏全屏的时候它就开始捣乱了：","href":null},{"type":"text","text":{"content":"小地图的边缘可能被切掉一截，血条最右边那格可能看不见，最惨的是 FPS 游戏里敌人蹲在刘海正下方你根本发现不了","link":null},"annotations":{"bold":true,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"小地图的边缘可能被切掉一截，血条最右边那格可能看不见，最惨的是 FPS 游戏里敌人蹲在刘海正下方你根本发现不了","href":null},{"type":"text","text":{"content":"。这不是夸张，是每个 MacBook 刘海屏玩家都经历过的真实场景。","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"。这不是夸张，是每个 MacBook 刘海屏玩家都经历过的真实场景。","href":null}],"icon":null,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-81fd-b2bb-e557df0f5232","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"paragraph","paragraph":{"rich_text":[{"type":"text","text":{"content":"更烦人的是，苹果压根没给一个像样的解决方案。系统设置里倒是藏了一个能避开刘海的「缩放分辨率」，但要点进系统设置、显示器、分辨率、选缩放、再挑一个不那么模糊的档位——前后四五层操作。玩完还得原路切回去，不然日常用着别扭。一晚上来回切几次，游戏的心情都没了。","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"更烦人的是，苹果压根没给一个像样的解决方案。系统设置里倒是藏了一个能避开刘海的「缩放分辨率」，但要点进系统设置、显示器、分辨率、选缩放、再挑一个不那么模糊的档位——前后四五层操作。玩完还得原路切回去，不然日常用着别扭。一晚上来回切几次，游戏的心情都没了。","href":null}],"icon":null,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-8126-8c65-d6c7302d6290","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"callout","callout":{"rich_text":[{"type":"text","text":{"content":"刘海看视频时是苹果的设计美学，玩游戏时就是画面中间一个吞视野的黑洞。","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"刘海看视频时是苹果的设计美学，玩游戏时就是画面中间一个吞视野的黑洞。","href":null}],"icon":{"type":"emoji","emoji":"⚠️"},"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-8177-87e0-cabe1b6e4edb","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"heading_2","heading_2":{"rich_text":[{"type":"text","text":{"content":"game-res：两条命令让它消失","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"game-res：两条命令让它消失","href":null}],"is_toggleable":false,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-81b2-974a-c85143052938","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"paragraph","paragraph":{"rich_text":[{"type":"text","text":{"content":"实在被搞烦了，就写了个脚本叫 ","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"实在被搞烦了，就写了个脚本叫 ","href":null},{"type":"text","text":{"content":"game-res","link":null},"annotations":{"bold":true,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"game-res","href":null},{"type":"text","text":{"content":"。思路很直接：玩游戏前敲 game-on，整个画面自动往下挪一截，刘海区域变成一条干净的黑边，游戏画面完整不被挡；玩完敲 game-off，切回默认的 Retina 分辨率，一切照旧。","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"。思路很直接：玩游戏前敲 game-on，整个画面自动往下挪一截，刘海区域变成一条干净的黑边，游戏画面完整不被挡；玩完敲 game-off，切回默认的 Retina 分辨率，一切照旧。","href":null}],"icon":null,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-814a-abc1-f86cde7174fb","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"paragraph","paragraph":{"rich_text":[{"type":"text","text":{"content":"原理说穿了很简单。16 寸 MacBook Pro 的默认逻辑分辨率是 1512 乘 982，刘海就卡在顶部菜单栏正中间。game-on 会切到 1512 乘 945 这个档位——高度刚好少 37 个像素，","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"原理说穿了很简单。16 寸 MacBook Pro 的默认逻辑分辨率是 1512 乘 982，刘海就卡在顶部菜单栏正中间。game-on 会切到 1512 乘 945 这个档位——高度刚好少 37 个像素，","href":null},{"type":"text","text":{"content":"而这 37 像素恰好就是刘海的高度","link":null},"annotations":{"bold":true,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"而这 37 像素恰好就是刘海的高度","href":null},{"type":"text","text":{"content":"。于是整个工作区整体下移，刘海被一条黑边盖住，画面干干净净。","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"。于是整个工作区整体下移，刘海被一条黑边盖住，画面干干净净。","href":null}],"icon":null,"color":"default"},"archived":false},{"object":"block","id":"39599968-1bdb-8173-a5d9-f1365017e938","parent":{"type":"page_id","page_id":"39599968-1bdb-81af-9d79-c5f08653b173"},"created_time":"2026-07-06T12:09:00.000Z","last_edited_time":"2026-07-06T12:09:00.000Z","created_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"last_edited_by":{"object":"user","id":"482aa66e-4aea-4811-9fbb-750cd1c10e34"},"has_children":false,"in_trash":false,"type":"image","image":{"caption":[{"type":"text","text":{"content":"实际终端运行效果：game-on / game-off / game-res 三条命令的输出","link":null},"annotations":{"bold":false,"italic":false,"strikethrough":false,"underline":false,"code":false,"color":"default"},"plain_text":"实际终端运行效果：game-on / game-off / game-res 三条命令的输出","href":null}],"type":"external","external":{"url":"https: