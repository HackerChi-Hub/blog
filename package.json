{
  "name": "hyphentech-obsidian-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "BLOG_CONTENT_DIR=../blog-content next dev",
    "build": "BLOG_CONTENT_DIR=./content-export next build && node scripts/post-build.js && node scripts/verify-export.js --content-dir ./content-export",
    "build:obsidian-test": "BLOG_CONTENT_DIR=./tests/fixtures/blog-content next build && node scripts/post-build.js && node scripts/verify-export.js --content-dir ./tests/fixtures/blog-content",
    "content:check": "node scripts/validate-content.js",
    "content:check-fixture": "node scripts/validate-content.js --content-dir ./tests/fixtures/blog-content",
    "content:sync": "node scripts/sync-obsidian-content.js",
    "content:import": "node scripts/import-article-content.js",
    "test:content": "node scripts/test-content-pipeline.js",
    "test:products": "node scripts/test-product-catalog.js",
    "start": "python3 -m http.server 4173 --directory out",
    "backup": "node scripts/backup.js",
    "deploy": "scripts/blog-publish",
    "publish": "scripts/blog-publish"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.1",
    "next": "^15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
